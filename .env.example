# ---- Browser (exposed to the client; safe because Row Level Security protects data) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Optional: client-side upload limit in MB (match your Supabase Storage limit; free plan = 50)
VITE_MAX_UPLOAD_MB=50

# ---- Server only (Vercel serverless function /api/livekit-token) ----
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET
